# ── Server (.env inside /server folder) ──────────────────
MISTRAL_API_KEY=your_mistral_api_key_here
PORT=3001
NODE_ENV=development
# Allow requests from the Vite dev server
CLIENT_ORIGIN=http://localhost:5173

# ── Client (.env inside /client folder) ──────────────────
# In development Vite proxies /api → localhost:3001
# so VITE_API_URL can be left empty for local dev.
# Set this only for production build:
# VITE_API_URL=https://accreditation-server.onrender.com
